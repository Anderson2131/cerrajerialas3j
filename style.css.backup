*{
margin:0;
padding:0;
box-sizing:border-box;
}

body{
font-family:'Montserrat',sans-serif;
background:#f8fafc;
color:#0f172a;
text-rendering:optimizeLegibility;
}

:root{
  --blue-950:#0b1228;
  --blue-900:#0f1b3d;
  --blue-800:#172554;
  --blue-700:#1e40af;
  --amber-500:#f59e0b;
  --amber-400:#fbbf24;
  --slate-900:#0f172a;
  --slate-700:#334155;
  --card:#ffffff;
  --muted:#f1f5f9;
  --shadow:0 20px 50px rgba(2,6,23,0.12);
  --shadow-soft:0 10px 25px rgba(2,6,23,0.10);
  --radius:24px;
}

/* Secciones (layout premium) */
.section{
  padding:96px 0;
}

.section-head{
  text-align:center;
  max-width:860px;
  margin:0 auto 42px auto;
}

.section-head h2{
  font-size:46px;
  color:var(--blue-900);
  letter-spacing:-0.6px;
  margin-bottom:12px;
}

.section-head p{
  color:var(--slate-700);
  font-size:18px;
  line-height:1.8;
}

/* Imágenes premium ultra profesionales */
.media-frame{
  position:relative;
  border-radius:28px;
  overflow:hidden;
  box-shadow:0 25px 60px rgba(2,6,23,0.15), 0 8px 25px rgba(2,6,23,0.08);
  border:2px solid rgba(255,255,255,0.08);
  background:linear-gradient(135deg, #0b1228, #172554);
  transition:transform 0.25s ease, box-shadow 0.25s ease;
}

.media-frame:hover{
  transform:translateY(-3px);
  box-shadow:0 32px 75px rgba(2,6,23,0.20), 0 12px 35px rgba(2,6,23,0.12);
}

.media-frame::after{
  content:"";
  position:absolute;
  inset:0;
  background:
    radial-gradient(1400px 600px at 15% 25%, rgba(245,158,11,0.18), transparent 60%),
    linear-gradient(135deg, rgba(15,27,61,0.65), rgba(11,18,40,0.25));
  mix-blend-mode:multiply;
  pointer-events:none;
}

.img-premium{
  width:100%;
  height:100%;
  object-fit:cover;
  display:block;
  filter:brightness(0.85) contrast(1.12) saturate(1.08) sharpen(0.5);
  transform:scale(1.02);
  transition:transform 0.25s ease, filter 0.25s ease;
}

.media-frame:hover .img-premium{
  transform:scale(1.05);
  filter:brightness(0.88) contrast(1.15) saturate(1.10) sharpen(0.6);
}

/* Banner1 optimizado para secciones de contacto */
.contact-image .media-frame{
  height:400px;
  border-radius:24px;
  overflow:hidden;
  box-shadow:0 25px 60px rgba(2,6,23,0.15), 0 8px 25px rgba(2,6,23,0.08);
  border:2px solid rgba(255,255,255,0.08);
  background:linear-gradient(135deg, #0b1228, #172554);
  transition:transform 0.25s ease, box-shadow 0.25s ease;
}

.contact-image .media-frame:hover{
  transform:translateY(-3px);
  box-shadow:0 32px 75px rgba(2,6,23,0.20), 0 12px 35px rgba(2,6,23,0.12);
}

.contact-image .img-premium{
  width:100%;
  height:100%;
  object-fit:cover;
  object-position:center;
  display:block;
  filter:brightness(0.85) contrast(1.12) saturate(1.08);
  transform:scale(1.02);
  transition:transform 0.25s ease, filter 0.25s ease;
}

.contact-image .media-frame:hover .img-premium{
  transform:scale(1.05);
  filter:brightness(0.88) contrast(1.15) saturate(1.10);
}

.nav-actions{
  display:flex;
  align-items:center;
  gap:16px;
}

.nav-phone{
  display:inline-flex;
  align-items:center;
  gap:10px;
  padding:12px 24px;
  background:linear-gradient(135deg, var(--amber-500), var(--amber-400));
  color:var(--blue-800);
  text-decoration:none;
  font-weight:700;
  border-radius:50px;
  box-shadow:0 6px 20px rgba(245,158,11,0.25);
  transition:all 0.2s ease;
  position:relative;
  overflow:hidden;
  border:2px solid rgba(255,255,255,0.2);
}

.nav-phone::before{
  content:"";
  position:absolute;
  top:0;
  left:-100%;
  width:100%;
  height:100%;
  background:linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
  transition:left 0.3s ease;
}

.nav-phone:hover{
  transform:translateY(-1px);
  box-shadow:0 8px 25px rgba(245,158,11,0.3);
  background:linear-gradient(135deg, var(--amber-400), var(--amber-500));
  border-color:rgba(255,255,255,0.25);
}

.nav-phone:hover::before{
  left:100%;
}

.nav-phone i{
  font-size:16px;
  color:var(--blue-800);
}

.nav-cta{
  display:inline-flex;
  align-items:center;
  gap:10px;
  padding:12px 24px;
  background:linear-gradient(135deg, var(--amber-500), var(--amber-400));
  color:var(--blue-800);
  text-decoration:none;
  font-weight:700;
  border-radius:50px;
  box-shadow:0 6px 20px rgba(245,158,11,0.25);
  transition:all 0.2s ease;
  position:relative;
  overflow:hidden;
  border:2px solid rgba(255,255,255,0.2);
}

.nav-cta::before{
  content:"";
  position:absolute;
  top:0;
  left:-100%;
  width:100%;
  height:100%;
  background:linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
  transition:left 0.3s ease;
}

.nav-cta:hover{
  transform:translateY(-1px);
  box-shadow:0 8px 25px rgba(245,158,11,0.3);
  background:linear-gradient(135deg, var(--amber-400), var(--amber-500));
  border-color:rgba(255,255,255,0.25);
}

.nav-cta:hover::before{
  left:100%;
}

.btn{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:10px;
  background:linear-gradient(135deg, var(--amber-500), var(--amber-400));
  padding:15px 34px;
  border-radius:999px;
  text-decoration:none;
  color:var(--blue-950);
  font-weight:800;
  letter-spacing:0.2px;
  box-shadow:0 12px 35px rgba(245,158,11,0.35);
  transform:translateY(0);
  transition:transform 0.18s ease, box-shadow 0.18s ease, filter 0.18s ease;
}

/* Enhanced Premium Hover Animations for All Buttons */
.btn:hover{
  transform:translateY(-3px) scale(1.03);
  box-shadow:0 20px 50px rgba(245,158,11,0.45);
  filter:saturate(1.1) brightness(1.05);
}

.btn:active{
  transform:translateY(-1px) scale(1.01);
}

.nav-cta:hover{
  transform:translateY(-2px) scale(1.02);
  box-shadow:0 15px 40px rgba(245,158,11,0.45);
  filter:brightness(1.1);
}

.nav-phone:hover{
  transform:translateY(-2px) scale(1.02);
  box-shadow:0 12px 30px rgba(2,6,23,0.25);
  background:rgba(255,255,255,0.18);
  border-color:rgba(255,255,255,0.35);
}

.whatsapp:hover{
  transform:translateY(-4px) scale(1.05);
  box-shadow:0 20px 50px rgba(37,211,102,0.6), 0 10px 25px rgba(0,0,0,0.3);
  filter:brightness(1.1);
}

.phone-float:hover{
  transform:translateY(-4px) scale(1.05);
  box-shadow:0 20px 50px rgba(245,158,11,0.7), 0 10px 25px rgba(0,0,0,0.3);
  filter:brightness(1.1);
}

.btn-premium-whatsapp:hover{
  transform:translateY(-4px) scale(1.03);
  box-shadow:0 25px 60px rgba(37,211,102,0.6), 0 12px 30px rgba(0,0,0,0.25);
  filter:brightness(1.15) saturate(1.1);
}

.btn-premium-phone:hover{
  transform:translateY(-4px) scale(1.03);
  box-shadow:0 25px 60px rgba(245,158,11,0.6), 0 12px 30px rgba(0,0,0,0.25);
  filter:brightness(1.15) saturate(1.1);
}

.btn.btn-secondary:hover{
  transform:translateY(-3px) scale(1.02);
  box-shadow:0 22px 60px rgba(2,6,23,0.35);
  filter:brightness(1.1);
}

.contact-form button:hover{
  transform:translateY(-4px) scale(1.02);
  box-shadow:0 25px 60px rgba(245,158,11,0.55);
  filter:brightness(1.15) saturate(1.1);
}

.contact-alternative .btn-secondary:hover{
  transform:translateY(-3px) scale(1.02);
  box-shadow:0 15px 35px rgba(2,6,23,0.4);
  filter:brightness(1.1);
}

/* Enhanced hover for all interactive elements */
a{
  transition:all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

button{
  transition:all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

/* Premium hover for service cards and features */
.service-card:hover{
  transform:translateY(-5px) scale(1.01);
  box-shadow:0 30px 80px rgba(2,6,23,0.25), 0 15px 40px rgba(2,6,23,0.15);
}

.feature-card:hover{
  transform:translateY(-4px) scale(1.02);
  box-shadow:0 25px 60px rgba(2,6,23,0.2), 0 10px 30px rgba(2,6,23,0.1);
}

.testi:hover{
  transform:translateY(-3px) scale(1.01);
  box-shadow:0 20px 50px rgba(2,6,23,0.15);
}

.coverage-card:hover{
  transform:translateY(-3px) scale(1.01);
  box-shadow:0 20px 50px rgba(2,6,23,0.15);
}

.faq-item:hover{
  transform:translateX(5px);
  background:rgba(245,158,11,0.05);
}

/* Enhanced hover for premium elements */
.premium-stat:hover{
  transform:translateY(-4px) scale(1.05);
  box-shadow:0 20px 50px rgba(0,0,0,0.3);
  background:rgba(255,255,255,0.25);
}

.benefit-item:hover{
  transform:translateY(-3px) scale(1.02);
  box-shadow:0 15px 40px rgba(0,0,0,0.25);
  background:rgba(255,255,255,0.15);
}

.benefit-stat:hover{
  transform:translateY(-3px) scale(1.05);
  box-shadow:0 15px 35px rgba(0,0,0,0.2);
  background:rgba(255,255,255,0.08);
}

.feature-tag:hover{
  transform:translateY(-3px) scale(1.02);
  background:rgba(255,255,255,0.25);
  border-color:rgba(255,255,255,0.4);
  box-shadow:0 10px 25px rgba(0,0,0,0.2);
}

.cta-feature:hover{
  transform:translateY(-3px) scale(1.02);
  box-shadow:0 12px 30px rgba(0,0,0,0.25);
  background:rgba(255,255,255,0.18);
}

.trust-item:hover{
  transform:translateY(-2px) scale(1.02);
  color:rgba(255,255,255,1);
}

.container{
width:90%;
max-width:1200px;
margin:auto;
}

header{
background:linear-gradient(135deg, 
  #0a0e27 0%, 
  var(--blue-950) 20%, 
  var(--blue-900) 40%, 
  var(--blue-800) 60%, 
  var(--blue-700) 80%, 
  var(--blue-600) 100%
);
padding:20px 0;
position:sticky;
top:0;
z-index:999;
border-bottom:1px solid rgba(255,255,255,0.15);
backdrop-filter:blur(5px);
box-shadow:0 4px 16px rgba(2,6,23,0.3), 0 1px 4px rgba(2,6,23,0.2);
position:relative;
overflow:hidden;
}

header::before{
content:"";
position:absolute;
top:0;
left:0;
right:0;
bottom:0;
background:
  radial-gradient(circle at 20% 50%, rgba(245,158,11,0.15) 0%, transparent 50%),
  radial-gradient(circle at 80% 20%, rgba(245,158,11,0.10) 0%, transparent 40%),
  linear-gradient(90deg, 
    transparent 0%, 
    rgba(255,255,255,0.03) 50%, 
    transparent 100%
  );
pointer-events:none;
z-index:1;
}

header::after{
content:"";
position:absolute;
top:0;
left:0;
right:0;
height:1px;
background:linear-gradient(90deg, 
  transparent 0%, 
  var(--amber-500) 50%, 
  transparent 100%
);
box-shadow:0 0 10px rgba(245,158,11,0.5);
pointer-events:none;
z-index:2;
}

.nav{
position:relative;
z-index:3;
}

/* Navbar optimizado para logo más grande con fondo oscuro - versión ligera */
.nav{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:32px;
  height:90px;
  background:linear-gradient(135deg, 
    #0a0e27 0%, 
    var(--blue-950) 30%, 
    var(--blue-900) 60%, 
    var(--blue-800) 100%
  );
  border-radius:20px;
  padding:15px 30px;
  box-shadow:0 4px 16px rgba(2,6,23,0.3), 0 1px 4px rgba(2,6,23,0.2);
  border:1px solid rgba(255,255,255,0.1);
  position:relative;
  overflow:hidden;
}

.nav::before{
  content:"";
  position:absolute;
  top:0;
  left:0;
  right:0;
  bottom:0;
  background:
    radial-gradient(circle at 20% 50%, rgba(245,158,11,0.04) 0%, transparent 50%),
    radial-gradient(circle at 80% 20%, rgba(245,158,11,0.03) 0%, transparent 40%);
  pointer-events:none;
  z-index:1;
}

.nav > *{
  position:relative;
  z-index:2;
}

.nav nav{
  margin-left:auto;
  flex:1;
  display:flex;
  justify-content:flex-end;
}

nav ul{
  display:flex;
  gap:36px;
  list-style:none;
  align-items:center;
}

nav ul li a{
color:white;
text-decoration:none;
font-weight:600;
opacity:0.95;
position:relative;
transition:all 0.2s ease;
padding:8px 0;
}

nav ul li a::before{
content:"";
position:absolute;
bottom:0;
left:50%;
width:0;
height:2px;
background:linear-gradient(90deg, var(--amber-500), var(--amber-400));
transform:translateX(-50%);
transition:width 0.2s ease;
border-radius:2px;
}

nav ul li a:hover{
opacity:1;
transform:translateY(-1px);
color:var(--amber-400);
text-shadow:0 0 4px rgba(245,158,11,0.3);
}

nav ul li a:hover::before{
width:60%;
box-shadow:0 0 6px rgba(245,158,11,0.4);
}

.nav-cta{
  display:inline-flex;
  align-items:center;
  gap:10px;
  padding:12px 16px;
  border-radius:999px;
  text-decoration:none;
  font-weight:900;
  color:#fff;
  background:rgba(255,255,255,0.10);
  border:1px solid rgba(255,255,255,0.16);
  backdrop-filter: blur(10px);
  transition:transform 0.15s ease, background 0.15s ease;
  white-space:nowrap;
}

.nav-cta:hover{
  transform:translateY(-1px);
  background:rgba(255,255,255,0.16);
}

.nav-cta i{
  font-size:18px;
}

/* Logo profesional sin bordes ni fondo */
.logo-container{
  display:flex;
  align-items:center;
  justify-content:flex-start;
  height:100%;
}

/* Logo más grande y prominente */
.brand-logo{
  width:220px;
  height:auto;
  padding:0;
  border-radius:0;
  background:transparent;
  border:none;
  box-shadow:none;
  filter:brightness(1.05) contrast(1.02) drop-shadow(none);
  transition:transform 0.20s ease, filter 0.20s ease;
  object-fit:contain;
}

.brand-logo:hover{
  transform:scale(1.03);
  filter:brightness(1.08) contrast(1.05);
}

.footer-logo .brand-logo{
  width:160px;
  height:auto;
  padding:0;
  background:transparent;
  border:none;
  box-shadow:none;
  filter:brightness(0.9) contrast(1.0);
}

.footer-logo .brand-logo:hover{
  filter:brightness(0.95) contrast(1.05);
}

.inline-logo{
  width:120px;
  height:auto;
  padding:0;
  border-radius:0;
  background:transparent;
  border:none;
  filter:brightness(1.0) contrast(1.0);
  margin-right:12px;
  vertical-align:middle;
}

/* Lightbox (visor de imagen) */
.brand-logo,
.inline-logo{
  cursor:zoom-in;
}

.lightbox{
  position:fixed;
  inset:0;
  z-index:2000;
  display:none;
  align-items:center;
  justify-content:center;
  padding:22px;
  background:rgba(2,6,23,0.72);
  backdrop-filter: blur(10px);
}

.lightbox.is-open{
  display:flex;
}

.lightbox-panel{
  width:min(92vw, 520px);
  max-height:70vh;
  border-radius:22px;
  border:1px solid rgba(255,255,255,0.14);
  background:rgba(255,255,255,0.06);
  box-shadow:0 35px 80px rgba(2,6,23,0.45);
  padding:16px;
}

.lightbox-img{
  width:100%;
  height:auto;
  max-height:50vh;
  object-fit:contain;
  display:block;
  border-radius:18px;
  background:#0b1228;
}

.lightbox-hint{
  margin-top:10px;
  font-size:14px;
  color:rgba(255,255,255,0.78);
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px;
}

.lightbox-pill{
  display:inline-flex;
  align-items:center;
  gap:10px;
  padding:8px 12px;
  border-radius:999px;
  background:rgba(255,255,255,0.10);
  border:1px solid rgba(255,255,255,0.14);
  color:#fff;
  font-weight:900;
}

.hero{
  min-height:90vh;
  position:relative;
  overflow:hidden;
  isolation:isolate;
}

.hero-swiper{
  height:90vh;
}

.hero-slide{
  height:90vh;
  background-size:cover;
  background-position:center;
  position:relative;
}

.hero-overlay{
  position:absolute;
  inset:0;
  background:
    radial-gradient(1100px 520px at 15% 25%, rgba(245,158,11,0.25), transparent 60%),
    linear-gradient(120deg, rgba(11,18,40,0.82), rgba(30,64,175,0.55));
}

.hero-inner{
  position:relative;
  z-index:2;
  height:90vh;
  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:flex-start;
  text-align:left;
  gap:14px;
  padding:28px 0;
}

.hero-badge{
  display:inline-flex;
  align-items:center;
  gap:10px;
  padding:10px 14px;
  border-radius:999px;
  background:rgba(255,255,255,0.10);
  border:1px solid rgba(255,255,255,0.16);
  color:rgba(255,255,255,0.92);
  font-weight:600;
  backdrop-filter: blur(10px);
}

.hero-inner h2{
  color:#fff;
  font-size:64px;
  line-height:1.02;
  letter-spacing:-0.8px;
}

.hero-inner p{
  color:rgba(255,255,255,0.92);
  font-size:20px;
  line-height:1.75;
  max-width:720px;
}

.hero-actions{
  display:flex;
  gap:12px;
  flex-wrap:wrap;
  margin-top:6px;
}

/* Swiper estilos premium */
.swiper-button-prev,
.swiper-button-next{
  width:46px !important;
  height:46px !important;
  border-radius:999px;
  border:1px solid rgba(255,255,255,0.18);
  background:rgba(2,6,23,0.24);
  backdrop-filter: blur(10px);
  transition:transform 0.15s ease, background 0.15s ease;
}

.swiper-button-prev:hover,
.swiper-button-next:hover{
  transform:translateY(-1px);
  background:rgba(2,6,23,0.38);
}

.swiper-button-prev::after,
.swiper-button-next::after{
  font-size:16px !important;
  font-weight:900;
  color:#fff;
}

.swiper-pagination-bullet{
  width:10px !important;
  height:10px !important;
  opacity:1 !important;
  background:rgba(255,255,255,0.22) !important;
  border:1px solid rgba(255,255,255,0.34) !important;
}

.swiper-pagination-bullet-active{
  width:28px !important;
  border-radius:999px !important;
  background:linear-gradient(135deg, var(--amber-500), var(--amber-400)) !important;
  border-color:rgba(245,158,11,0.65) !important;
}

.info-home{
padding:100px 20px;
text-align:center;
}

.info-home h2{
font-size:45px;
color:var(--blue-800);
margin-bottom:30px;
font-weight:600;
}

.info-home p{
max-width:900px;
margin:auto;
font-size:20px;
line-height:1.8;
color:var(--slate-700);
}

.home-cards{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
gap:30px;
margin-top:60px;
}

.mini-card{
background:white;
padding:40px 30px;
border-radius:20px;
box-shadow:var(--shadow-soft);
border:1px solid rgba(15,23,42,0.06);
transform:translateY(0);
transition:transform 0.18s ease, box-shadow 0.18s ease;
}

.mini-card:hover{
transform:translateY(-4px);
box-shadow:var(--shadow);
}

/* Stats */
.stats{
  background:linear-gradient(180deg, rgba(15,27,61,0.06), rgba(245,158,11,0.05));
}

.stats-grid{
  display:grid;
  grid-template-columns:repeat(4, minmax(0,1fr));
  gap:18px;
}

.stat-card{
  background:rgba(255,255,255,0.9);
  border:1px solid rgba(15,23,42,0.08);
  border-radius:var(--radius);
  padding:22px 20px;
  box-shadow:var(--shadow-soft);
}

.stat-icon{
  width:46px;
  height:46px;
  border-radius:16px;
  display:grid;
  place-items:center;
  background:linear-gradient(135deg, rgba(30,64,175,0.18), rgba(245,158,11,0.18));
  color:var(--blue-900);
  margin-bottom:14px;
}

.stat-value{
  font-size:40px;
  font-weight:900;
  letter-spacing:-0.6px;
  color:var(--blue-950);
}

.stat-suffix{
  font-size:18px;
  font-weight:800;
  margin-left:6px;
  color:rgba(15,23,42,0.65);
}

.stat-label{
  margin-top:8px;
  color:var(--slate-700);
  line-height:1.6;
}

/* Why */
.why{
  background:#fff;
}

.why-grid{
  display:grid;
  grid-template-columns:1.2fr 0.8fr;
  gap:26px;
  align-items:stretch;
}

.why-copy h2{
  font-size:48px;
  color:var(--blue-900);
  letter-spacing:-0.7px;
  margin-bottom:14px;
}

.why-copy p{
  color:var(--slate-700);
  line-height:1.85;
  font-size:18px;
}

.checklist{
  margin-top:18px;
  display:flex;
  flex-direction:column;
  gap:10px;
  list-style:none;
  padding:0;
}

.checklist li{
  display:flex;
  align-items:flex-start;
  gap:10px;
  color:var(--slate-700);
  line-height:1.7;
}

.checklist i{
  color:var(--amber-500);
  margin-top:3px;
}

.why-card{
  border-radius:var(--radius);
  border:1px solid rgba(15,23,42,0.08);
  background:linear-gradient(180deg, rgba(15,27,61,0.97), rgba(30,64,175,0.88));
  color:#fff;
  overflow:hidden;
  box-shadow:var(--shadow);
  display:flex;
  flex-direction:column;
  justify-content:space-between;
}

.why-card-top{
  padding:26px 24px 18px 24px;
}

.why-card-badge{
  display:inline-flex;
  gap:10px;
  align-items:center;
  padding:8px 12px;
  border-radius:999px;
  background:rgba(255,255,255,0.12);
  border:1px solid rgba(255,255,255,0.18);
  font-weight:700;
  margin-bottom:14px;
}

.why-card-top h3{
  font-size:28px;
  letter-spacing:-0.4px;
  margin-bottom:10px;
}

.why-card-top p{
  opacity:0.92;
  line-height:1.75;
}

.why-card-bottom{
  padding:18px 18px 22px 18px;
  display:flex;
  flex-wrap:wrap;
  gap:10px;
}

.chip{
  padding:10px 12px;
  border-radius:999px;
  background:rgba(2,6,23,0.25);
  border:1px solid rgba(255,255,255,0.14);
  display:inline-flex;
  gap:10px;
  align-items:center;
  font-weight:700;
  font-size:14px;
}

/* Featured services */
.featured{
  background:linear-gradient(180deg, rgba(15,27,61,0.04), rgba(245,158,11,0.04));
}

.feature-grid{
  display:grid;
  grid-template-columns:repeat(4, minmax(0,1fr));
  gap:18px;
}

.feature-card{
  background:rgba(255,255,255,0.92);
  border:1px solid rgba(15,23,42,0.08);
  border-radius:var(--radius);
  padding:22px 20px;
  box-shadow:var(--shadow-soft);
  text-decoration:none;
  color:inherit;
  transition:transform 0.18s ease, box-shadow 0.18s ease;
}

.feature-card:hover{
  transform:translateY(-4px);
  box-shadow:var(--shadow);
}

.feature-icon{
  width:46px;
  height:46px;
  border-radius:16px;
  display:grid;
  place-items:center;
  background:linear-gradient(135deg, rgba(245,158,11,0.22), rgba(30,64,175,0.22));
  color:var(--blue-900);
  margin-bottom:14px;
}

.feature-card h3{
  color:var(--blue-900);
  font-size:20px;
  letter-spacing:-0.2px;
  margin-bottom:8px;
}

.feature-card p{
  color:var(--slate-700);
  line-height:1.75;
}

.feature-cta{
  display:inline-flex;
  align-items:center;
  gap:10px;
  margin-top:14px;
  font-weight:900;
  color:var(--blue-900);
}

/* Testimonials */
.testimonials{
  background:#fff;
}

.testi-grid{
  display:grid;
  grid-template-columns:repeat(3, minmax(0,1fr));
  gap:18px;
}

.testi{
  background:rgba(255,255,255,0.92);
  border:1px solid rgba(15,23,42,0.08);
  border-radius:var(--radius);
  padding:22px 20px;
  box-shadow:var(--shadow-soft);
}

.testi-stars{
  color:var(--amber-500);
  letter-spacing:1px;
  font-weight:900;
  margin-bottom:10px;
}

.testi p{
  color:var(--slate-700);
  line-height:1.85;
  margin-bottom:14px;
}

.testi-name{
  font-weight:900;
  color:var(--blue-900);
}

/* Coverage */
.coverage{
  background:linear-gradient(180deg, rgba(15,27,61,0.05), rgba(255,255,255,1));
}

.coverage-grid{
  display:grid;
  grid-template-columns:repeat(3, minmax(0,1fr));
  gap:18px;
}

.coverage-card{
  background:rgba(255,255,255,0.92);
  border:1px solid rgba(15,23,42,0.08);
  border-radius:var(--radius);
  padding:22px 20px;
  box-shadow:var(--shadow-soft);
}

.coverage-icon{
  width:46px;
  height:46px;
  border-radius:16px;
  display:grid;
  place-items:center;
  background:linear-gradient(135deg, rgba(30,64,175,0.18), rgba(245,158,11,0.18));
  color:var(--blue-900);
  margin-bottom:14px;
}

.coverage-card h3{
  color:var(--blue-900);
  font-size:20px;
  margin-bottom:8px;
  letter-spacing:-0.2px;
}

.coverage-card p{
  color:var(--slate-700);
  line-height:1.8;
}

.coverage-tags{
  display:flex;
  flex-wrap:wrap;
  gap:10px;
  margin-top:14px;
}

.tag{
  display:inline-flex;
  align-items:center;
  padding:8px 12px;
  border-radius:999px;
  background:rgba(15,23,42,0.05);
  border:1px solid rgba(15,23,42,0.08);
  color:rgba(15,23,42,0.75);
  font-weight:900;
  font-size:13px;
}

/* FAQ */
.faq{
  background:#fff;
}

.faq-list{
  max-width:860px;
  margin:0 auto;
}

.faq-item{
  width:100%;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:16px;
  padding:18px 18px;
  border-radius:18px;
  border:1px solid rgba(15,23,42,0.08);
  background:rgba(255,255,255,0.92);
  box-shadow:var(--shadow-soft);
  cursor:pointer;
  font-weight:900;
  color:var(--blue-900);
  text-align:left;
}

.faq-item + .faq-a{
  margin-top:10px;
  margin-bottom:14px;
}

.faq-q{
  line-height:1.4;
}

.faq-ico{
  width:38px;
  height:38px;
  border-radius:14px;
  display:grid;
  place-items:center;
  background:linear-gradient(135deg, rgba(245,158,11,0.20), rgba(30,64,175,0.20));
  border:1px solid rgba(15,23,42,0.08);
  flex:0 0 auto;
}

.faq-a{
  overflow:hidden;
  max-height:0;
  opacity:0;
  transform:translateY(-4px);
  transition:max-height 0.28s ease, opacity 0.28s ease, transform 0.28s ease;
  color:var(--slate-700);
  line-height:1.85;
  padding:0 18px;
}

.faq-a.is-open{
  opacity:1;
  transform:none;
  padding:14px 18px 6px 18px;
}

/* Sección Premium CTA Moderna con imagen de fondo */
.premium-cta-section{
  padding:100px 0;
  background-image:url('img/baner1.jpg');
  background-size:cover;
  background-position:center center;
  background-repeat:no-repeat;
  position:relative;
  overflow:hidden;
  min-height:600px;
  display:flex;
  align-items:center;
}

.premium-cta-section::before{
  content:"";
  position:absolute;
  top:0;
  left:0;
  right:0;
  bottom:0;
  background:linear-gradient(135deg, 
    rgba(2,6,23,0.85) 0%, 
    rgba(15,27,61,0.75) 50%, 
    rgba(2,6,23,0.85) 100%
  );
  backdrop-filter:blur(3px);
  z-index:1;
}

.premium-cta-section::after{
  content:"";
  position:absolute;
  top:0;
  left:0;
  right:0;
  bottom:0;
  background:
    radial-gradient(circle at 20% 50%, rgba(245,158,11,0.20) 0%, transparent 50%),
    radial-gradient(circle at 80% 20%, rgba(245,158,11,0.15) 0%, transparent 40%),
    radial-gradient(circle at 50% 80%, rgba(255,255,255,0.08) 0%, transparent 30%);
  pointer-events:none;
  z-index:2;
}

.premium-cta-container{
  position:relative;
  z-index:3;
  background:rgba(255,255,255,0.12);
  backdrop-filter:blur(25px);
  border:2px solid rgba(255,255,255,0.25);
  border-radius:32px;
  padding:60px 50px;
  box-shadow:0 30px 80px rgba(2,6,23,0.6), 0 15px 40px rgba(2,6,23,0.4);
  text-align:center;
  max-width:1000px;
  margin:0 auto;
  transition:transform 0.3s ease, box-shadow 0.3s ease;
}

.premium-cta-container:hover{
  transform:translateY(-5px);
  box-shadow:0 40px 100px rgba(2,6,23,0.5), 0 20px 50px rgba(2,6,23,0.3);
}

.premium-cta-header{
  margin-bottom:50px;
}

.premium-cta-badge{
  display:inline-flex;
  align-items:center;
  gap:12px;
  padding:12px 20px;
  background:linear-gradient(135deg, var(--amber-500), var(--amber-400));
  color:var(--blue-950);
  border-radius:50px;
  font-weight:700;
  font-size:14px;
  text-transform:uppercase;
  letter-spacing:0.5px;
  margin-bottom:24px;
  box-shadow:0 8px 25px rgba(245,158,11,0.3);
  animation:badge-pulse 2s infinite;
}

@keyframes badge-pulse{
  0%, 100%{
    transform:scale(1);
  }
  50%{
    transform:scale(1.05);
  }
}

.premium-cta-badge i{
  font-size:16px;
}

.premium-cta-title{
  font-size:52px;
  font-weight:800;
  color:#ffffff;
  margin-bottom:20px;
  text-shadow:0 3px 6px rgba(0,0,0,0.4), 0 0 20px rgba(245,158,11,0.3);
  letter-spacing:-0.8px;
  line-height:1.1;
}

.premium-cta-subtitle{
  font-size:22px;
  color:rgba(255,255,255,0.95);
  max-width:650px;
  margin:0 auto 30px;
  line-height:1.7;
  font-weight:600;
  text-shadow:0 2px 4px rgba(0,0,0,0.3);
}

.premium-cta-features{
  display:grid;
  grid-template-columns:repeat(3, 1fr);
  gap:30px;
  margin-bottom:50px;
}

.premium-cta-feature{
  background:rgba(255,255,255,0.08);
  border:1px solid rgba(255,255,255,0.15);
  border-radius:24px;
  padding:30px 25px;
  transition:all 0.3s ease;
  backdrop-filter:blur(10px);
}

.premium-cta-feature:hover{
  transform:translateY(-5px);
  background:rgba(255,255,255,0.12);
  border-color:rgba(255,255,255,0.25);
  box-shadow:0 20px 50px rgba(0,0,0,0.3);
}

.premium-cta-icon{
  width:60px;
  height:60px;
  background:linear-gradient(135deg, var(--amber-500), var(--amber-400));
  border-radius:18px;
  display:flex;
  align-items:center;
  justify-content:center;
  margin:0 auto 20px;
  font-size:24px;
  color:var(--blue-950);
  box-shadow:0 10px 30px rgba(245,158,11,0.3);
  transition:all 0.3s ease;
}

.premium-cta-feature:hover .premium-cta-icon{
  transform:scale(1.1) rotate(5deg);
  box-shadow:0 15px 40px rgba(245,158,11,0.4);
}

.premium-cta-text h4{
  font-size:18px;
  font-weight:700;
  color:#ffffff;
  margin-bottom:8px;
  text-shadow:0 1px 2px rgba(0,0,0,0.2);
}

.premium-cta-text p{
  font-size:14px;
  color:rgba(255,255,255,0.8);
  line-height:1.5;
  font-weight:500;
}

.premium-cta-actions{
  display:flex;
  gap:20px;
  justify-content:center;
  margin-bottom:40px;
  flex-wrap:wrap;
}

.premium-cta-btn{
  display:inline-flex;
  align-items:center;
  gap:12px;
  padding:18px 32px;
  border-radius:50px;
  text-decoration:none;
  font-weight:700;
  font-size:16px;
  transition:all 0.3s ease;
  border:2px solid transparent;
  position:relative;
  overflow:hidden;
}

.premium-cta-btn.primary{
  background:linear-gradient(135deg, #25d366, #20b957);
  color:#ffffff;
  box-shadow:0 15px 40px rgba(37,211,102,0.6), 0 5px 15px rgba(0,0,0,0.3), inset 0 1px 0 rgba(255,255,255,0.3);
  border:2px solid rgba(255,255,255,0.2);
  position:relative;
  overflow:hidden;
}

.premium-cta-btn.primary::before{
  content:"";
  position:absolute;
  top:0;
  left:-100%;
  width:100%;
  height:100%;
  background:linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
  transition:left 0.5s ease;
}

.premium-cta-btn.primary:hover{
  transform:translateY(-4px) scale(1.05);
  box-shadow:0 20px 60px rgba(37,211,102,0.7), 0 8px 25px rgba(0,0,0,0.4), inset 0 1px 0 rgba(255,255,255,0.4);
  background:linear-gradient(135deg, #20b957, #1da852);
  border-color:rgba(255,255,255,0.4);
}

.premium-cta-btn.primary:hover::before{
  left:100%;
}

.premium-cta-btn.secondary{
  background:linear-gradient(135deg, var(--amber-500), var(--amber-400));
  color:var(--blue-950);
  box-shadow:0 15px 40px rgba(245,158,11,0.6), 0 5px 15px rgba(0,0,0,0.3), inset 0 1px 0 rgba(255,255,255,0.3);
  border:2px solid rgba(255,255,255,0.2);
  position:relative;
  overflow:hidden;
}

.premium-cta-btn.secondary::before{
  content:"";
  position:absolute;
  top:0;
  left:-100%;
  width:100%;
  height:100%;
  background:linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
  transition:left 0.5s ease;
}

.premium-cta-btn.secondary:hover{
  transform:translateY(-4px) scale(1.05);
  box-shadow:0 20px 60px rgba(245,158,11,0.7), 0 8px 25px rgba(0,0,0,0.4), inset 0 1px 0 rgba(255,255,255,0.4);
  background:linear-gradient(135deg, var(--amber-400), var(--amber-500));
  border-color:rgba(255,255,255,0.4);
}

.premium-cta-btn.secondary:hover::before{
  left:100%;
}

.premium-cta-btn i{
  font-size:18px;
}

.premium-cta-trust{
  display:flex;
  justify-content:center;
  gap:40px;
  flex-wrap:wrap;
  padding-top:30px;
  border-top:1px solid rgba(255,255,255,0.15);
}

.trust-item{
  display:flex;
  align-items:center;
  gap:8px;
  color:rgba(255,255,255,0.9);
  font-weight:600;
  font-size:14px;
  transition:all 0.3s ease;
}

.trust-item:hover{
  color:#ffffff;
  transform:translateY(-2px);
}

.trust-item i{
  color:var(--amber-400);
  font-size:16px;
}

/* Responsive para la sección premium CTA */

/* Media Queries para Tablets y Dispositivos Medianos */
@media(max-width:900px){
  .hero-inner{
    align-items:flex-start;
  }

  .hero-inner h2{
    font-size:42px;
  }

  .hero-inner p{
    font-size:17px;
  }

  .nav{
    flex-direction:row;
    gap:20px;
    height:auto;
    padding:15px 0;
  }

  .brand-logo{
    width:140px;
  }

  .service-card{
    flex-direction:column;
    text-align:center;
    padding:25px;
    gap:20px;
  }

  .service-card img{
    width:100%;
    max-width:300px;
    height:200px;
  }

  .page-title-premium h2{
    font-size:34px;
  }

  .about-container{
    flex-direction:column;
    gap:30px;
  }

  .section{
    padding:80px 0;
  }

  .stats-grid{
    grid-template-columns:repeat(2, minmax(0,1fr));
  }

  .why-grid{
    grid-template-columns:1fr;
  }

  .feature-grid{
    grid-template-columns:repeat(2, minmax(0,1fr));
  }

  .testi-grid{
    grid-template-columns:1fr;
  }

  .coverage-grid{
    grid-template-columns:1fr;
  }

  .cta-inner{
    flex-direction:column;
    align-items:flex-start;
  }

  .footer-grid{
    grid-template-columns:1fr;
  }

  .contact-box{
    width:95%;
    min-height:500px;
    margin:60px auto;
  }

  .contact-content{
    grid-template-columns:1fr;
    gap:30px;
  }

  .contact-form{
    padding:40px 30px;
    max-width:450px;
  }

  .contact-form h2{
    font-size:32px;
  }

  .contact-subtitle{
    font-size:16px;
  }

  .contact-form input,
  .contact-form select,
  .contact-form textarea{
    padding:15px;
    font-size:16px;
  }

  .contact-form button{
    padding:15px 25px;
    font-size:16px;
  }

  .benefits-grid{
    grid-template-columns:1fr;
    gap:15px;
  }

  .benefit-item{
    padding:20px;
    text-align:center;
  }

  .benefit-icon{
    font-size:32px;
    margin-bottom:15px;
  }

  .benefit-text h4{
    font-size:16px;
  }

  .benefit-text p{
    font-size:14px;
  }

  .phone-float{
    right:20px;
    bottom:80px;
    width:56px;
    height:56px;
    font-size:24px;
  }

  .whatsapp{
    right:20px;
    bottom:20px;
    width:56px;
    height:56px;
    font-size:26px;
  }

  .page-title{
    padding:80px 20px;
  }

  .page-title h2{
    font-size:32px;
    line-height:1.2;
  }

  .page-title p{
    font-size:16px;
    line-height:1.6;
  }
}

.services-page{
padding:100px 8%;
display:flex;
flex-direction:column;
gap:40px;
}

.page-title{
  background-image:url('img/baner2.jpg');
  background-size:cover;
  background-position:center center;
  background-repeat:no-repeat;
  position:relative;
  padding:100px 20px;
  text-align:center;
  overflow:hidden;
}

.page-title::before{
  content:"";
  position:absolute;
  top:0;
  left:0;
  right:0;
  bottom:0;
  background:linear-gradient(135deg, 
    rgba(11,18,40,0.92) 0%, 
    rgba(30,64,175,0.85) 50%, 
    rgba(245,158,11,0.25) 100%
  );
  backdrop-filter:blur(2px);
  z-index:1;
}

.page-title::after{
  content:"";
  position:absolute;
  top:0;
  left:0;
  right:0;
  bottom:0;
  background:
    radial-gradient(circle at 20% 30%, rgba(245,158,11,0.15) 0%, transparent 50%),
    radial-gradient(circle at 80% 70%, rgba(255,255,255,0.08) 0%, transparent 40%),
    url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" width="100" height="100" viewBox="0 0 100 100"><rect width="100" height="100" fill="none"/><circle cx="20" cy="20" r="2" fill="rgba(245,158,11,0.2)"/><circle cx="80" cy="80" r="2" fill="rgba(245,158,11,0.2)"/><circle cx="50" cy="10" r="1" fill="rgba(255,255,255,0.1)"/><circle cx="10" cy="70" r="1" fill="rgba(255,255,255,0.1)"/></svg>');
  background-size:100% 100%, 100% 100%, 100px 100px;
  pointer-events:none;
  z-index:2;
}

.page-title > *{
  position:relative;
  z-index:3;
}

.page-title h2{
  font-size:56px;
  color:#ffffff;
  font-weight:800;
  text-shadow:0 4px 8px rgba(0,0,0,0.5), 0 0 30px rgba(245,158,11,0.4);
  letter-spacing:-0.8px;
  margin-bottom:20px;
  line-height:1.1;
}

.page-title p{
  font-size:22px;
  color:rgba(255,255,255,0.95);
  max-width:800px;
  margin:0 auto;
  line-height:1.7;
  font-weight:600;
  text-shadow:0 2px 4px rgba(0,0,0,0.4);
}

/* Mejoras profesionales para tarjetas de servicios - versión optimizada */
.service-card{
  display:flex;
  gap:35px;
  align-items:center;
  background:white;
  padding:35px;
  border-radius:28px;
  box-shadow:0 12px 30px rgba(2,6,23,0.08), 0 4px 15px rgba(2,6,23,0.06);
  transition:all 0.2s ease;
  border:2px solid transparent;
  background-clip:padding-box;
  position:relative;
  overflow:hidden;
}

.service-card::before{
  content:"";
  position:absolute;
  inset:0;
  padding:2px;
  background:linear-gradient(135deg, var(--blue-700), var(--amber-500), var(--blue-700));
  border-radius:28px;
  mask:linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  mask-composite:exclude;
  z-index:1;
}

.service-card::after{
  content:"";
  position:absolute;
  top:0;
  left:0;
  right:0;
  height:3px;
  background:linear-gradient(90deg, var(--amber-500), var(--amber-400));
  opacity:0;
  transition:opacity 0.2s ease;
}

.service-card:hover{
  transform:translateY(-3px);
  box-shadow:0 16px 40px rgba(2,6,23,0.12), 0 6px 20px rgba(2,6,23,0.08);
}

.service-card:hover::before{
  opacity:1;
}

.service-card img{
  width:350px;
  height:250px;
  object-fit:cover;
  border-radius:22px;
  filter:brightness(0.88) contrast(1.12) saturate(1.08);
  box-shadow:0 15px 40px rgba(2,6,23,0.12);
}

/* Mejoras para íconos de servicios */
.service-card h3{
  font-size:35px;
  color:var(--blue-800);
  margin-bottom:15px;
  font-weight:600;
  display:flex;
  align-items:center;
  gap:12px;
}

.service-card h3 i{
  font-size:32px;
  color:var(--amber-500);
  margin-right:8px;
}

.service-card h3::before{
  content:"";
  font-size:32px;
  margin-right:8px;
  filter:drop-shadow(0 2px 4px rgba(245,158,11,0.2));
}

.service-card p{
  font-size:18px;
  line-height:1.8;
  color:var(--slate-700);
}

.about-page{
  padding:100px 8%;
}

.about-container{
  display:flex;
  gap:50px;
  align-items:center;
  flex-wrap:wrap;
}

.about-image-big img{
  width:500px;
  border-radius:28px;
  box-shadow:0 25px 60px rgba(2,6,23,0.12), 0 10px 30px rgba(2,6,23,0.08);
  filter:brightness(0.88) contrast(1.12) saturate(1.08);
  transition:transform 0.25s ease, box-shadow 0.25s ease;
}

.about-image-big img:hover{
  transform:translateY(-3px);
  box-shadow:0 32px 75px rgba(2,6,23,0.18), 0 15px 40px rgba(2,6,23,0.12);
}

.about-info{
  flex:1;
}

.about-info h2{
font-size:50px;
color:var(--blue-800);
margin-bottom:25px;
font-weight:600;
}

.about-info p{
font-size:20px;
line-height:1.9;
margin-bottom:20px;
color:var(--slate-700);
}

/* Sección Solicita tu Servicio Premium con fondo completo */
.contact-box{
  position:relative;
  width:90%;
  max-width:1200px;
  margin:80px auto;
  background-image:url('img/baner1.jpg');
  background-size:cover;
  background-position:center center;
  background-repeat:no-repeat;
  border-radius:30px;
  overflow:hidden;
  min-height:600px;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:40px;
}

.contact-box::before{
  content:"";
  position:absolute;
  top:0;
  left:0;
  right:0;
  bottom:0;
  background:linear-gradient(135deg, 
    rgba(2,6,23,0.75) 0%, 
    rgba(15,27,61,0.65) 50%, 
    rgba(2,6,23,0.75) 100%
  );
  backdrop-filter:blur(2px);
  z-index:1;
}

.contact-content{
  position:relative;
  z-index:2;
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:40px;
  width:100%;
  max-width:1000px;
  align-items:start;
}

.contact-form{
  background:rgba(255,255,255,0.08);
  backdrop-filter:blur(20px);
  border:2px solid rgba(255,255,255,0.15);
  border-radius:28px;
  padding:50px;
  box-shadow:0 25px 60px rgba(2,6,23,0.40), 0 10px 30px rgba(2,6,23,0.20);
  transition:transform 0.3s ease, box-shadow 0.3s ease;
}

.contact-form:hover{
  transform:translateY(-5px);
  box-shadow:0 35px 80px rgba(2,6,23,0.50), 0 15px 40px rgba(2,6,23,0.30);
}

.contact-form h2{
  font-size:42px;
  margin-bottom:12px;
  color:#fff;
  font-weight:700;
  text-align:center;
  text-shadow:0 2px 4px rgba(2,6,23,0.3);
  letter-spacing:-0.5px;
}

.contact-subtitle{
  text-align:center;
  color:rgba(255,255,255,0.9);
  font-size:18px;
  margin-bottom:35px;
  line-height:1.6;
  font-weight:500;
}

.contact-benefits{
  background:rgba(255,255,255,0.06);
  backdrop-filter:blur(15px);
  border:2px solid rgba(255,255,255,0.12);
  border-radius:28px;
  padding:40px;
  box-shadow:0 20px 50px rgba(2,6,23,0.30), 0 8px 25px rgba(2,6,23,0.15);
  transition:transform 0.3s ease, box-shadow 0.3s ease;
}

.contact-benefits:hover{
  transform:translateY(-3px);
  box-shadow:0 25px 60px rgba(2,6,23,0.40), 0 12px 35px rgba(2,6,23,0.25);
}

.benefits-header{
  text-align:center;
  margin-bottom:30px;
}

.benefits-header h3{
  font-size:28px;
  color:#fff;
  font-weight:700;
  margin-bottom:12px;
  text-shadow:0 2px 4px rgba(2,6,23,0.3);
  letter-spacing:-0.3px;
}

.benefits-header p{
  color:rgba(255,255,255,0.85);
  font-size:16px;
  line-height:1.6;
  font-weight:500;
}

.benefits-grid{
  display:grid;
  grid-template-columns:repeat(2, 1fr);
  gap:20px;
  margin-bottom:30px;
}

.benefit-item{
  display:flex;
  align-items:center;
  gap:15px;
  padding:20px;
  background:rgba(255,255,255,0.08);
  border:1px solid rgba(255,255,255,0.15);
  border-radius:20px;
  transition:transform 0.2s ease, background 0.2s ease;
}

.benefit-item:hover{
  transform:translateY(-2px);
  background:rgba(255,255,255,0.12);
}

.benefit-icon{
  width:50px;
  height:50px;
  background:linear-gradient(135deg, var(--amber-500), var(--amber-400));
  border-radius:15px;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:20px;
  color:var(--blue-950);
  box-shadow:0 8px 20px rgba(245,158,11,0.3);
  flex-shrink:0;
}

.benefit-text h4{
  font-size:16px;
  color:#fff;
  font-weight:700;
  margin-bottom:4px;
}

.benefit-text p{
  font-size:14px;
  color:rgba(255,255,255,0.8);
  line-height:1.4;
  font-weight:500;
}

.benefits-stats{
  display:grid;
  grid-template-columns:repeat(3, 1fr);
  gap:15px;
  margin-top:25px;
  padding-top:25px;
  border-top:1px solid rgba(255,255,255,0.15);
}

.benefit-stat{
  text-align:center;
  padding:15px 10px;
  background:rgba(255,255,255,0.05);
  border-radius:15px;
  border:1px solid rgba(255,255,255,0.1);
  transition:transform 0.2s ease;
}

.benefit-stat:hover{
  transform:translateY(-2px);
}

.benefit-stat-number{
  font-size:24px;
  font-weight:800;
  color:var(--amber-400);
  margin-bottom:4px;
  display:block;
}

.benefit-stat-label{
  font-size:12px;
  color:rgba(255,255,255,0.9);
  font-weight:600;
  text-transform:uppercase;
  letter-spacing:0.5px;
}

.contact-form form{
  display:flex;
  flex-direction:column;
  gap:20px;
}

.contact-form input,
.contact-form select,
.contact-form textarea{
  padding:18px;
  border:2px solid rgba(255,255,255,0.2);
  background:rgba(255,255,255,0.08);
  border-radius:16px;
  font-size:16px;
  outline:none;
  transition:all 0.3s ease;
  color:#fff;
  font-weight:500;
}

.contact-form input::placeholder,
.contact-form textarea::placeholder{
  color:rgba(255,255,255,0.6);
}

.contact-form input:focus,
.contact-form select:focus,
.contact-form textarea:focus{
  border-color:var(--amber-400);
  background:rgba(255,255,255,0.12);
  box-shadow:0 0 20px rgba(245,158,11,0.2);
}

.contact-form select{
  color:#fff;
  cursor:pointer;
}

.contact-form select option{
  background:var(--blue-900);
  color:#fff;
}

.contact-form textarea{
  height:120px;
  resize:none;
}

.contact-form button{
  background:linear-gradient(135deg, var(--amber-500), var(--amber-400));
  color:var(--blue-950);
  border:none;
  padding:20px;
  font-size:18px;
  font-weight:700;
  border-radius:16px;
  cursor:pointer;
  box-shadow:0 15px 40px rgba(245,158,11,0.35);
  transition:transform 0.3s ease, box-shadow 0.3s ease, filter 0.3s ease;
  text-transform:uppercase;
  letter-spacing:0.5px;
  position:relative;
  overflow:hidden;
}

.contact-form button::before{
  content:"";
  position:absolute;
  top:0;
  left:-100%;
  width:100%;
  height:100%;
  background:linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
  transition:left 0.5s ease;
}

.contact-form button:hover{
  transform:translateY(-3px);
  box-shadow:0 20px 50px rgba(245,158,11,0.45);
  filter:brightness(1.1);
}

.contact-form button:hover::before{
  left:100%;
}

.contact-form button:active{
  transform:translateY(-1px);
}

.contact-alternative{
  text-align:center;
  margin-top:25px;
  padding-top:25px;
  border-top:1px solid rgba(255,255,255,0.15);
}

.contact-alternative p{
  color:rgba(255,255,255,0.8);
  margin-bottom:15px;
  font-size:15px;
}

.contact-alternative .btn-secondary{
  background:rgba(255,255,255,0.1);
  color:#fff;
  border:2px solid rgba(255,255,255,0.25);
  padding:14px 28px;
  font-size:16px;
  font-weight:600;
  border-radius:50px;
  text-decoration:none;
  display:inline-flex;
  align-items:center;
  gap:10px;
  transition:all 0.3s ease;
}

.contact-alternative .btn-secondary:hover{
  background:rgba(255,255,255,0.18);
  border-color:rgba(255,255,255,0.35);
  transform:translateY(-2px);
  box-shadow:0 10px 25px rgba(2,6,23,0.3);
}

.whatsapp{
position:fixed;
bottom:25px;
right:25px;
width:75px;
height:75px;
border-radius:50%;
background:linear-gradient(135deg, #25d366, #20b957);
color:#fff;
border:3px solid rgba(255,255,255,0.3);
cursor:pointer;
box-shadow:0 15px 40px rgba(37,211,102,0.6), 0 8px 25px rgba(0,0,0,0.3), inset 0 2px 4px rgba(255,255,255,0.2);
font-size:36px;
display:flex;
align-items:center;
justify-content:center;
text-decoration:none;
z-index:1000;
transition:all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
animation:whatsapp-pulse 3s infinite;
backdrop-filter:blur(10px);
}

@keyframes whatsapp-pulse{
0%, 100%{
    transform:scale(1);
}
50%{
    transform:scale(1.05);
}
}

.whatsapp:hover{
transform:translateY(-5px) scale(1.1);
box-shadow:0 20px 50px rgba(37,211,102,0.7), 0 12px 30px rgba(0,0,0,0.4), inset 0 2px 4px rgba(255,255,255,0.3);
background:linear-gradient(135deg, #25d366, #1da852);
border-color:rgba(255,255,255,0.5);
}

.whatsapp:active{
transform:translateY(-2px) scale(1.05);
}

.phone-float{
position:fixed;
bottom:25px;
right:110px;
width:70px;
height:70px;
border-radius:50%;
background:linear-gradient(135deg, var(--amber-500), var(--amber-400));
color:var(--blue-950);
border:3px solid rgba(255,255,255,0.3);
cursor:pointer;
box-shadow:0 15px 40px rgba(245,158,11,0.6), 0 8px 25px rgba(0,0,0,0.3), inset 0 2px 4px rgba(255,255,255,0.2);
font-size:32px;
display:flex;
align-items:center;
justify-content:center;
text-decoration:none;
z-index:1000;
transition:all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
animation:phone-pulse 3s infinite;
backdrop-filter:blur(10px);
}

@keyframes phone-pulse{
0%, 100%{
    transform:scale(1);
}
50%{
    transform:scale(1.05);
}
}

.phone-float:hover{
transform:translateY(-3px);
box-shadow:0 15px 40px rgba(245,158,11,0.6), 0 8px 20px rgba(0,0,0,0.25);
background:linear-gradient(135deg, var(--amber-400), var(--amber-500));
}

/* Footer */
.footer{
  margin-top:80px;
  background:linear-gradient(135deg, var(--blue-950), var(--blue-900));
  color:rgba(255,255,255,0.9);
  border-top:1px solid rgba(255,255,255,0.08);
}

.footer-grid{
  padding:54px 0;
  display:grid;
  grid-template-columns:1.35fr 0.65fr 0.65fr 0.65fr;
  gap:24px;
}

.footer-logo{
  display:flex;
  align-items:center;
  gap:10px;
  font-weight:900;
  font-size:18px;
  margin-bottom:14px;
}

.footer-brand p{
  color:rgba(255,255,255,0.78);
  line-height:1.85;
  margin-bottom:16px;
}

.footer-social{
  display:flex;
  gap:10px;
  flex-wrap:wrap;
}

.footer-pill{
  display:inline-flex;
  gap:10px;
  align-items:center;
  padding:10px 12px;
  border-radius:999px;
  background:rgba(255,255,255,0.10);
  border:1px solid rgba(255,255,255,0.14);
  color:#fff;
  text-decoration:none;
  font-weight:800;
}

.footer-col h3{
  font-size:16px;
  letter-spacing:0.2px;
  margin-bottom:12px;
  color:#fff;
}

.footer-col a{
  display:block;
  color:rgba(255,255,255,0.78);
  text-decoration:none;
  margin:8px 0;
  line-height:1.6;
}

.footer-col a:hover{
  color:#fff;
}

.footer-kv{
  display:flex;
  align-items:center;
  gap:10px;
  margin:10px 0;
  color:rgba(255,255,255,0.82);
}

.footer-bottom{
  border-top:1px solid rgba(255,255,255,0.08);
  padding:14px 0;
  color:rgba(255,255,255,0.68);
}

/* Responsive Design Optimizado - Tablets y Dispositivos Medianos */
@media(max-width:900px){
  .hero-inner{
    align-items:flex-start;
    padding:40px 20px;
  }

  .hero-inner h2{
    font-size:42px;
    line-height:1.2;
  }

  .hero-inner p{
    font-size:17px;
    line-height:1.6;
  }

  .nav{
    flex-direction:column;
    gap:20px;
    height:auto;
    padding:20px;
    border-radius:16px;
  }

  .nav-actions{
    order:3;
    width:100%;
    justify-content:center;
    gap:16px;
  }

  .nav-phone, .nav-cta{
    flex:1;
    max-width:200px;
  }

  nav{
    order:2;
    width:100%;
  }

  nav ul{
    gap:20px;
    flex-wrap:wrap;
    justify-content:center;
  }

  .nav nav{
    margin-left:0;
    flex:1;
  }

  nav ul{
    gap:24px;
    flex-wrap:wrap;
    justify-content:center;
  }

  .brand-logo{
    width:160px;
    height:auto;
    padding:0;
    border-radius:0;
    background:transparent;
    border:none;
    box-shadow:none;
    filter:brightness(1.02) contrast(1.01);
  }

  .brand-logo:hover{
    transform:scale(1.02);
    filter:brightness(1.04) contrast(1.03);
  }

  .footer-logo .brand-logo{
    width:120px;
    height:auto;
    padding:0;
    background:transparent;
    border:none;
    box-shadow:none;
    filter:brightness(0.9) contrast(1.0);
  }

  .inline-logo{
    width:80px;
    height:auto;
    padding:0;
    border-radius:0;
    background:transparent;
    border:none;
    filter:brightness(1.0) contrast(1.0);
  }

  .service-card{
    flex-direction:column;
    gap:25px;
    padding:30px;
    border-radius:22px;
  }

  .service-card:hover{
    transform:translateY(-3px);
  }

  .service-card img{
    width:100%;
    max-width:350px;
    height:220px;
    border-radius:18px;
    box-shadow:0 12px 30px rgba(2,6,23,0.10);
  }

  .page-title-premium{
    padding:60px 0;
  }

  .premium-header-content{
    padding:0 15px;
  }

  .page-title-premium h2{
    font-size:36px;
  }

  .premium-subtitle{
    font-size:18px;
    margin:0 auto 30px;
  }

  .premium-stats{
    grid-template-columns:repeat(2, 1fr);
    gap:15px;
    margin:0 auto 30px;
  }

  .premium-stat{
    padding:15px 10px;
  }

  .stat-number{
    font-size:28px;
  }

  .premium-features{
    gap:10px;
  }

  .feature-tag{
    padding:6px 12px;
    font-size:13px;
  }

  .cta-premium{
    padding:70px 0;
  }

  .cta-premium-content{
    grid-template-columns:1fr;
    gap:40px;
  }

  .cta-urgency{
    text-align:center;
  }

  .urgency-badge{
    margin-bottom:20px;
  }

  .cta-premium h2{
    font-size:38px;
  }

  .cta-main-text{
    font-size:18px;
    margin-bottom:25px;
  }

  .cta-features{
    grid-template-columns:1fr;
    gap:15px;
    margin-bottom:30px;
  }

  .cta-actions{
    flex-direction:column;
    align-items:center;
    gap:15px;
  }

  .cta-trust{
    justify-content:center;
    margin-top:30px;
    padding-top:20px;
  }

  .about-container{
    flex-direction:column;
    gap:40px;
  }

  .about-image-big img{
    width:100%;
    max-width:500px;
    border-radius:22px;
  }

  .section{
    padding:72px 0;
  }

  .section-head h2{
    font-size:34px;
  }

  .stats-grid{
    grid-template-columns:repeat(2, minmax(0,1fr));
  }

  .why-grid{
    grid-template-columns:1fr;
  }

  .feature-grid{
    grid-template-columns:repeat(2, minmax(0,1fr));
  }

  .testi-grid{
    grid-template-columns:1fr;
  }

  .coverage-grid{
    grid-template-columns:1fr;
  }

  .cta-inner{
    flex-direction:column;
    align-items:flex-start;
  }

  .footer-grid{
    grid-template-columns:1fr;
  }

  .contact-box{
    width:95%;
    min-height:500px;
    margin:60px auto;
  }

  .contact-content{
    grid-template-columns:1fr;
    gap:30px;
  }

  .contact-form{
    padding:40px 30px;
    max-width:450px;
  }

  .contact-form h2{
    font-size:32px;
    margin-bottom:10px;
  }

  .contact-subtitle{
    font-size:16px;
    margin-bottom:25px;
  }

  .benefits-grid{
    grid-template-columns:1fr;
    gap:15px;
  }

  .benefits-stats{
    grid-template-columns:repeat(3, 1fr);
    gap:10px;
    margin-top:20px;
    padding-top:20px;
  }

  .benefit-stat{
    padding:12px 8px;
  }

  .benefit-stat-number{
    font-size:20px;
  }

  .phone-float{
    right:25px;
    bottom:100px;
    width:60px;
    height:60px;
    font-size:28px;
  }
  
  .whatsapp{
    width:60px;
    height:60px;
    font-size:30px;
  }
  
  .premium-cta-features{
    grid-template-columns:1fr;
    gap:20px;
    margin-bottom:40px;
  }
  
  .nav-actions{
    gap:12px;
  }
  
  .nav-phone{
    padding:10px 16px;
    font-size:14px;
  }
  
  .nav-cta{
    padding:10px 16px;
    font-size:14px;
  }
  
  nav ul li a{
    font-size:14px;
    padding:6px 0;
  }
  
  nav ul li a::before{
    height:1.5px;
  }
  
  nav ul li a:hover::before{
    width:60%;
  }
  
  .service-card{
    flex-direction:column;
    text-align:center;
    padding:25px;
    gap:20px;
  }
  
  .service-card::before{
    background:linear-gradient(135deg, var(--blue-700), var(--amber-500), var(--blue-700));
  }
  
  .service-card:hover{
    transform:translateY(-5px);
  }
  
  header{
    padding:15px 0;
  }
  
  header::before{
    background:
      radial-gradient(circle at 20% 50%, rgba(245,158,11,0.10) 0%, transparent 50%),
      radial-gradient(circle at 80% 20%, rgba(245,158,11,0.08) 0%, transparent 40%);
  }

  .whatsapp{
    right:90px;
    bottom:25px;
  }
}